{
    "name": "Youtube Bookmarker",
    "version": "0.1.0",
    "description": "Saving timestamps in YT videos",
    "permissions": ["activeTab", "storage", "tabs", "nativeMessaging"],
    "host_permissions": ["https://*.youtube.com/*"],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["https://*.youtube.com/*"],
        "js": ["contentScript.js"],
        "css": ["content.css"]
      }
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "bookmark-icon.png"
        ],
        "matches": ["https://*.youtube.com/*"]
      }
    ],
    "action": {
        "default_icon": {
          "16": "bookmark-logo.png",
          "24": "bookmark-logo.png",
          "32": "bookmark-logo.png"
        },
        "default_title": "Youtube Bookmarker",
        "default_popup": "index.html"
      },
    "manifest_version": 3
}
